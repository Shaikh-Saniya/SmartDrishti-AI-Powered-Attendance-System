# Application
APP_NAME="Face Attendance System"
DEBUG=False
SECRET_KEY="your-secret-key-here-min-32-chars-change-me"
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/attendance_db"

# JWT
JWT_SECRET_KEY="your-jwt-secret-key-change-me-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS=24

# ML
INSIGHTFACE_MODEL_NAME="buffalo_l"
INSIGHTFACE_ROOT="./models"
FACE_DETECTION_THRESHOLD=0.5
COSINE_SIMILARITY_THRESHOLD=0.6
CPU_MODE=True

# File Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png"
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"
